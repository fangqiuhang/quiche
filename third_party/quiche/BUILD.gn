# Build file for QUICHE, <https://quiche.googlesource.com/quiche/>
#
# The following build targets are defined:
#   - quiche -- the part of QUICHE that is shipped within Chromium proper.
#   - *_tool_support -- support code used in CLI tools and unit tests.
#   - *_test_support -- support code only used in unit tests.
#   - quiche_tests -- all of the QUICHE test targets.
#
# There are two kinds of build target: quiche_ and epoll_; quiche_ targets are
# built on all platforms, epoll_ targets are only built on Linux and certain
# similar platforms.

# Dependency graph of the key targets in this file:
#
#     quiche <--- quiche_tool_support <--- quiche_test_support <--- quiche_tests
#                          ^                        ^                     |
#                          |                        |                     |
#                          |                        |                     |
#                   io_tool_support <-------------------------------------+ (*)
#
#             (*) on epoll platforms, quiche_tests also compiles the io/epoll
#                 tests and their test support (io_test_support_srcs) inline.

import("//third_party/protobuf/proto_library.gni")
import("//third_party/quiche/src/build/source_list.gni")

build_epoll_based_tools = is_linux || is_chromeos

config("quiche_internal_config") {
  cflags = []
  defines = []
  if (is_clang) {
    cflags += [ "-Wno-sign-compare" ]
  }
  if (build_win_over_msvc) {
    # Suppress C4244: narrowing conversion in quiche code
    # (e.g., WebTransportSessionId uint64_t -> uint32_t in std::optional).
    #
    # Suppress C4267: size_t narrowing to quiche::QuicPacketLength reported
    # from inside MSVC STL (xutility) while instantiating quiche templates
    # that feed a size_t into a QuicPacketLength (a narrow integer type)
    # parameter; the values are bounded so the loss is benign.
    #
    # Suppress C4715: "not all control paths return a value" in
    # blind_sign_auth.cc. QuicheProxyLayerToPpnProxyLayer() (line ~704) and
    # BlindSignAuthServiceTypeToString() (line ~735) switch over enums covering
    # every enumerator, but omit a `default:` case and a trailing return, so
    # MSVC cannot prove the switch is exhaustive and emits C4715. Safe to
    # suppress: the switch is exhaustive over the enum.
    #
    # Suppress C4834: discarding [[nodiscard]] return value. In
    # quic_crypto_server_config_test.cc the SerializedProtoEquals matcher
    # calls protobuf's SerializeToString() (which returns a [[nodiscard]]
    # bool) and discards the result.
    cflags += [
      "/wd4244",
      "/wd4267",
      "/wd4715",
      "/wd4834",
    ]

    # |ssize_t| is POSIX; MSVC only provides it via windows.h as |SSIZE_T|.
    # Map it to |ptrdiff_t| (the signed pointer-sized type it stands for) so
    # files like quic/moqt/moqt_names.cc could compile on MSVC.
    defines += [ "ssize_t=ptrdiff_t" ]
  } else {
    cflags += [
      "-Wno-deprecated-declarations",  # absl::WriterMutexLock deprecated
                                       # pointer ctor
                                       # (cached_blind_sign_auth.h).
      "-Wno-narrowing",  # moqt tests initialize char arrays with values
                         # > 127 (e.g. moqt_parser_test.cc) which GCC flags
                         # as narrowing.
      "-Wno-subobject-linkage",  # gtest parameterized test defined in an
                                 # anonymous namespace
                                 # (ObliviousHttpParameterizedTest).
      "-Wno-unused-result",  # protobuf SerializeToString() [[nodiscard]] bool
                             # ignored (quic_crypto_server_config_test.cc).
    ]
  }
  if (is_apple) {
    cflags += [ "-Wno-nullability-completeness" ]
    ldflags = [
      "-framework",
      "CoreFoundation",
    ]
  }
  if (is_win) {
    defines += [ "WIN32_LEAN_AND_MEAN" ]
    if (is_clang) {
      # VS clang uses MSVC headers, which don't define ssize_t (POSIX). Map it
      # to ptrdiff_t, exactly as the MSVC branch above does.
      defines += [ "ssize_t=ptrdiff_t" ]
    }
  }
}

config("quiche_config") {
  include_dirs = [
    # The ordering here is important, since headers in overrides/ replace
    # headers in src/common/platform/default.
    "overrides",
    "src/quiche/common/platform/default",
    "src",
  ]
}

static_library("quiche") {
  # TODO(crbug.com/325102878): Remove once usage of the deprecated version of
  # absl::HexStringToBytes have been removed.
  if (!build_win_over_msvc) {
    cflags = [ "-Wno-deprecated-declarations" ]
  }
  sources = [
              "src/quiche/common/platform/default/quiche_platform_impl/quiche_flags_impl.cc",
              "src/quiche/common/platform/default/quiche_platform_impl/quiche_flags_impl.h",
              "src/quiche/common/platform/default/quiche_platform_impl/quiche_logging_impl.cc",
              "src/quiche/common/platform/default/quiche_platform_impl/quiche_logging_impl.h",
              "src/quiche/http2/hpack/hpack_static_table_entries.inc",
            ] + quiche_core_hdrs + quiche_core_srcs + binary_http_srcs +
            binary_http_hdrs + oblivious_http_srcs + oblivious_http_hdrs

  if (!is_ios) {
    sources += [
      "src/quiche/common/platform/default/quiche_platform_impl/quiche_bug_tracker_impl.h",
      "src/quiche/common/platform/default/quiche_platform_impl/quiche_client_stats_impl.h",
      "src/quiche/common/platform/default/quiche_platform_impl/quiche_containers_impl.h",
      "src/quiche/common/platform/default/quiche_platform_impl/quiche_export_impl.h",
      "src/quiche/common/platform/default/quiche_platform_impl/quiche_iovec_impl.h",
      "src/quiche/common/platform/default/quiche_platform_impl/quiche_reference_counted_impl.h",
      "src/quiche/common/platform/default/quiche_platform_impl/quiche_server_stats_impl.h",
      "src/quiche/common/platform/default/quiche_platform_impl/quiche_stack_trace_impl.cc",
      "src/quiche/common/platform/default/quiche_platform_impl/quiche_stack_trace_impl.h",
      "src/quiche/common/platform/default/quiche_platform_impl/quiche_time_utils_impl.cc",
      "src/quiche/common/platform/default/quiche_platform_impl/quiche_time_utils_impl.h",
      "src/quiche/common/platform/default/quiche_platform_impl/quiche_url_utils_impl.cc",
      "src/quiche/common/platform/default/quiche_platform_impl/quiche_url_utils_impl.h",
    ]
  }

  configs += [ ":quiche_internal_config" ]
  configs += [ "//third_party/googleurl:googleurl_config" ]
  all_dependent_configs = [ ":quiche_config" ]

  deps = [
    "//third_party/abseil-cpp:flags_flag",
    "//third_party/googleurl:url",
    "//third_party/protobuf:protobuf_lite",
    "//third_party/zlib",
  ]

  public_deps = [
    ":net_quic_proto",
    "//third_party/abseil-cpp:absl",
    "//third_party/boringssl",
    "//third_party/googleurl:url",
  ]

  defines = [ "IS_QUICHE_IMPL" ]
}

proto_library("net_quic_proto") {
  visibility = [
    ":masque_support",
    ":quic_server_factory",
    ":quiche",
  ]

  sources = [
    "src/quiche/quic/core/proto/cached_network_parameters.proto",
    "src/quiche/quic/core/proto/crypto_server_config.proto",
    "src/quiche/quic/core/proto/source_address_token.proto",
  ]
  cc_generator_options = "dllexport_decl=COMPONENT_EXPORT(QUICHE):"
  cc_include = "third_party/googleurl/src/polyfills/base/component_export.h"
  component_build_force_source_set = true

  proto_in_dir = "src"

  link_public_deps = [ "//third_party/googleurl:url" ]

  defines = [ "IS_QUICHE_IMPL" ]
}

proto_library("net_quic_test_tools_proto") {

# MOQT (bazel: moqt_core / moqt_test_support). Uses autogenerated lists from
# src/build/source_list.gni; the moqt tests themselves are aggregated into
# quiche_tests.
source_set("moqt_core") {
  testonly = true
  sources = moqt_srcs + moqt_hdrs

  # The moqt CLI tools are POSIX-only (they #include <poll.h> and use the
  # poll-based event loop); not built on Windows.
  if (is_win) {
    sources -= [
      "src/quiche/quic/moqt/tools/chat_client.cc",
      "src/quiche/quic/moqt/tools/moq_chat.cc",
      "src/quiche/quic/moqt/tools/moqt_client.cc",
      "src/quiche/quic/moqt/tools/moqt_relay.cc",
      "src/quiche/quic/moqt/tools/moqt_server.cc",
    ]
  }

  configs += [ ":quiche_internal_config" ]
  public_configs = [ ":quiche_config" ]

  deps = [
    ":quiche",
    ":quiche_tool_support",
    "//third_party/abseil-cpp:absl",
    "//third_party/quic_trace:quic_trace_proto",
  ]
  if (!is_ios) {
    deps += [ ":io_tool_support" ]
  }
}

source_set("moqt_test_support") {
  testonly = true
  sources = moqt_test_support_srcs + moqt_test_support_hdrs

  configs += [ ":quiche_internal_config" ]
  public_configs = [ ":quiche_config" ]

  deps = [
    ":moqt_core",
    ":quiche",
    ":quiche_test_support",
    "//third_party/abseil-cpp:absl",
    "//third_party/googletest:gmock",
    "//third_party/googletest:gtest",
  ]
}

# QUICHE-provided CLI tools that don't use epoll.
if (!is_ios) {
  # The two libraries below, quic_client_core and quic_server_core, define
  # mutually exclusive command-line flags, and thus any target depending
  # directly on both will fail to build.  Only executable targets should depend
  # on those.
  source_set("quic_client_core") {
    testonly = true

    # TODO(crbug.com/325102878): Remove once usage of the deprecated version of
    # absl::HexStringToBytes have been removed.
    if (!build_win_over_msvc) {
      cflags = [ "-Wno-deprecated-declarations" ]
    }
    sources = [
      "src/quiche/quic/tools/quic_toy_client.cc",
      "src/quiche/quic/tools/quic_toy_client.h",
    ]

    configs += [ ":quiche_internal_config" ]
    public_configs = [ ":quiche_config" ]

    deps = [ ":quiche" ]
  }
  source_set("quic_server_core") {
    testonly = true
    sources = [
      "src/quiche/quic/tools/quic_toy_server.cc",
      "src/quiche/quic/tools/quic_toy_server.h",
    ]

    configs += [ ":quiche_internal_config" ]
    public_configs = [ ":quiche_config" ]

    deps = [ ":quiche" ]
  }

  # IO abstraction layer (io_tool_support in Bazel). Cross-platform, not
  # epoll-specific despite the legacy name.
  static_library("io_tool_support") {
    # TODO(crbug.com/325102878): Remove once usage of the deprecated version of
    # absl::HexStringToBytes have been removed.
    if (!build_win_over_msvc) {
      cflags = [ "-Wno-deprecated-declarations" ]
    }
    testonly = true

    sources = [
                "src/quiche/common/platform/default/quiche_platform_impl/quiche_stream_buffer_allocator_impl.h",
                "src/quiche/common/platform/default/quiche_platform_impl/quiche_udp_socket_platform_impl.h",
              ] + io_tool_support_srcs + io_tool_support_hdrs

    # Linux/ChromeOS-only QUIC core sources (batch writer + Linux socket
    # utils). They are kept separate from quiche_core_srcs in the upstream
    # autogenerated lists; they live here rather than in the `quiche` library
    # because quic_linux_socket_utils.cc calls GetGlobalSyscallWrapper()
    # (defined in quic_syscall_wrapper.cc, also in this target), which would
    # otherwise be a circular library dependency.
    if (build_epoll_based_tools) {
      sources += linux_only_srcs + linux_only_hdrs
    }

    # quic_syscall_wrapper and interactive_cli are POSIX-only.
    if (is_win) {
      sources -= [
        "src/quiche/quic/core/quic_syscall_wrapper.cc",
        "src/quiche/quic/core/quic_syscall_wrapper.h",
        "src/quiche/quic/tools/interactive_cli.cc",
        "src/quiche/quic/tools/interactive_cli.h",
      ]

      # socket_win.inc uses absl::StripAsciiWhitespace without including
      # the relevant header (absl/strings/ascii.h).
      if (build_win_over_msvc) {
        cflags += [ "/FIabsl/strings/ascii.h" ]
      } else {
        cflags += [
          "-include",
          "absl/strings/ascii.h",
          "-include",
          "winsock2.h",
          "-include",
          "mswsock.h",
        ]
      }
    }

    configs += [ ":quiche_internal_config" ]
    public_configs = [ ":quiche_config" ]

    deps = [
      ":quiche",
      ":quiche_tool_support",
      "//third_party/abseil-cpp:absl",
      "//third_party/boringssl",
    ]
  }

  source_set("quic_server_factory") {
    testonly = true
    sources = [
      "src/quiche/quic/tools/quic_server_factory.cc",
      "src/quiche/quic/tools/quic_server_factory.h",
    ]

    configs += [ ":quiche_internal_config" ]
    public_configs = [ ":quiche_config" ]

    deps = [
      ":io_tool_support",
      ":net_quic_proto",
      ":quic_server_core",
      "//third_party/abseil-cpp:absl",
      "//third_party/boringssl",
    ]
  }

  if (!is_win) {
    static_library("masque_support") {
      testonly = true
      sources = masque_support_srcs + masque_support_hdrs

      configs += [ ":quiche_internal_config" ]
      public_configs = [ ":quiche_config" ]

      deps = [
        ":io_tool_support",
        ":net_quic_proto",
        ":quiche_tool_support",
        "//third_party/boringssl",
        "//third_party/protobuf:protobuf_lite",
      ]
    }
  }

  executable("quic_client") {
    testonly = true
    sources = [ "src/quiche/quic/tools/quic_client_bin.cc" ]

    configs += [ ":quiche_internal_config" ]
    public_configs = [ ":quiche_config" ]

    deps = [
      ":io_tool_support",
      ":quic_client_core",
      ":quiche",
      ":quiche_tool_support",
      "//third_party/abseil-cpp:absl",
      "//third_party/boringssl",
    ]
  }

  executable("quic_client_interop_test") {
    testonly = true
    sources = [ "src/quiche/quic/tools/quic_client_interop_test_bin.cc" ]

    configs += [ ":quiche_internal_config" ]
    public_configs = [ ":quiche_config" ]

    deps = [
      ":io_tool_support",
      ":quiche",
      ":quiche_test_support",
      ":quiche_tool_support",
      "//third_party/abseil-cpp:absl",
      "//third_party/boringssl",
    ]
  }

  executable("quic_server") {
    testonly = true
    sources = [ "src/quiche/quic/tools/quic_server_bin.cc" ]

    configs += [ ":quiche_internal_config" ]
    public_configs = [ ":quiche_config" ]

    deps = [

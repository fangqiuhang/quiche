  sources = [
    "src/quiche/common/platform/api/testdir/README.md",
    "src/quiche/common/platform/api/testdir/a/b/c/d/e",
    "src/quiche/common/platform/api/testdir/a/subdir/testfile",
    "src/quiche/common/platform/api/testdir/a/z",
    "src/quiche/common/platform/api/testdir/testfile",
  ]
  outputs = [ "{{bundle_resources_dir}}/" +
              "{{source_root_relative_dir}}/{{source_file_part}}" ]
}

source_set("quiche_tests") {
  testonly = true

  # TODO(crbug.com/325102878): Remove once usage of the deprecated version of
  # absl::HexStringToBytes have been removed.
  if (!build_win_over_msvc) {
    cflags = [
      "-Wno-deprecated-declarations",

      # moqt_parser_test.cc (and other byte-array tests) use `char data[] = {
      # 0x80, 0xff, ... }`. On GCC/Clang `char` is signed, so these values are
      # narrowing list-initializations that GCC 14 rejects by default (MSVC's
      # `char` is unsigned, so it never errors). The tests treat `char` as an
      # opaque byte buffer, so the narrowing is intended; suppress it rather
      # than switching the whole build to -funsigned-char (which Abseil notes
      # breaks SIMD compares). Cannot patch the submodule source.
      "-Wno-narrowing",
    ]
  }

  # Use the autogenerated source lists from src/build/source_list.gni so the
  # test set stays in sync with upstream QUICHE, instead of a hand-maintained
  # list. quiche_tests_hdrs currently is empty but is included for forward
  # compatibility.
  sources = quiche_tests_srcs + quiche_tests_hdrs

  # The blind_sign_auth tests live in their own autogenerated list.
  sources += blind_sign_auth_tests_srcs

  # MOQT tests (autogenerated list, bazel: moqt_tests).
  sources += moqt_test_srcs

  # The moqt tool tests are POSIX-only (they exercise the poll-based CLI
  # tools), matching the moqt_core exclusions above.
  if (is_win) {
    sources -= [
      "src/quiche/quic/moqt/tools/moq_chat_end_to_end_test.cc",
      "src/quiche/quic/moqt/tools/moq_chat_test.cc",
      "src/quiche/quic/moqt/tools/moqt_end_to_end_test.cc",
      "src/quiche/quic/moqt/tools/moqt_relay_test.cc",
      "src/quiche/quic/moqt/tools/moqt_server_test.cc",
    ]
  }

  # balsa is not built in this glue (no balsa library), so drop its tests.
  # The fuzz tests are no-ops under the fuzztest stub (FUZZ_TEST expands to a
  # declaration), and quiche_data_writer_fuzz_test.cc additionally uses
  # fuzztest::InRange/Map/StructOf/VariantOf/VectorOf which the stub does not
  # provide, so it would not compile.
  # bbr3_simulator_test.cc and http2_structure_decoder_remaining_payload_test.cc
  # define the same gtest suites (Bbr2MultiSenderTest / MinRttFilter and the
  # Http2*FieldsDecoderTest suites) as bbr2_simulator_test.cc and
  # http2_structure_decoder_test.cc; gtest rejects two TUs registering the same
  # suite in one binary. Like Chromium's hand-curated quiche_tests list, they
  # are simply dropped here rather than built as separate binaries.
  sources -= [
    "src/quiche/balsa/balsa_frame_test.cc",
    "src/quiche/balsa/balsa_headers_sequence_test.cc",
    "src/quiche/balsa/balsa_headers_test.cc",
    "src/quiche/balsa/header_properties_test.cc",
    "src/quiche/balsa/simple_buffer_test.cc",
    "src/quiche/common/quiche_data_writer_fuzz_test.cc",
    "src/quiche/http2/decoder/http2_structure_decoder_remaining_payload_test.cc",
    "src/quiche/quic/core/congestion_control/bbr3_simulator_test.cc",
    "src/quiche/quic/core/quic_inlined_string_view_fuzz_test.cc",
    "src/quiche/quic/moqt/moqt_parser_fuzz_test.cc",
  ]

  if (build_win_over_msvc) {
    # The bundled googletest compares raw C strings by pointer (not content) in
    # EXPECT_EQ, and MSVC does not pool string literals, so
    # BugUtilsTest.BugListener fails on MSVC builds. GCC/Clang pool identical
    # string literals, so the test passes on mingw/Linux/mac.
    sources -= [ "src/quiche/common/bug_utils_test.cc" ]
  }

  if (is_linux) {
    # structured_headers_generated_test.cc initializes
    # std::optional<std::vector<...>> from aggregate-style braced lists, which
    # GCC 14's libstdc++ rejects (the optional converting constructor became
    # explicit). MSVC and older MinGW accept it, so it is dropped only on
    # Linux/GCC. The non-generated structured_headers_test.cc still covers the
    # same surface.
    #
    # moqt_relay_test.cc is a POSIX-only MOQT tool test that was never run on
    # any platform before (Windows excludes it), and MoqtRelayTest.SubscribeNamespace
    # segfaults under GCC 14 on Linux, aborting the whole quiche_unittests
    # binary. Cannot patch the submodule source, so exclude it in the glue.
    sources -= [
      "src/quiche/common/structured_headers_generated_test.cc",
      "src/quiche/quic/moqt/tools/moqt_relay_test.cc",
    ]
  }

  if (build_win_over_mingw) {
    # MinGW cannot symbolize stack traces (absl::Symbolize leaves "(unknown)" in
    # every frame), so QuicheStackTraceTest would fail; drop it on MinGW only.
    sources -= [ "src/quiche/common/platform/api/quiche_stack_trace_test.cc" ]
  }

  data = [ "src/quiche/common/platform/api/testdir/" ]

  configs += [ ":quiche_internal_config" ]
  public_configs = [ ":quiche_config" ]

  deps = [
    ":blind_sign_auth",
    ":blind_sign_auth_test_support",
    ":moqt_core",
    ":moqt_test_support",

    # The inlined io_test_support sources (quic_test_client / quic_test_server /
    # server_thread) include quiche_export.h -> quiche_export_impl.h and
    # protobuf-generated headers, which need the abseil, boringssl, googleurl,
    # and net_quic_proto include paths exposed by :quiche.
    ":quiche",
    "//third_party/googletest:gmock",
    "//third_party/googletest:gtest",
    "//third_party/protobuf:protobuf_lite",
  ]
  if (is_ios) {
    deps += [ ":test_data" ]
  }
  public_deps = []

  if (build_epoll_based_tools) {
    # Autogenerated list (bazel: io_tests / io_tests_srcs).
    sources += io_tests_srcs

    # Autogenerated list (bazel: linux_only_tests_srcs): the batch writer and
    # Linux socket-utils tests, which only build on Linux/ChromeOS.
    sources += linux_only_tests_srcs

    # quic_simple_server_stream_test.cc is an epoll-based io test that was
    # never run on any platform before (Windows excludes the io tests), and
    # QuicSimpleServerStreamTest.TestFraming segfaults under GCC 14 on Linux,
    # aborting the whole quiche_unittests binary. Cannot patch the submodule
    # source, so exclude it in the glue.
    sources -= [ "src/quiche/quic/tools/quic_simple_server_stream_test.cc" ]

    # The io/epoll test-support helpers (quic_test_client, quic_test_server,
    # server_thread, quic_mock_syscall_wrapper, quic_server_peer).
    sources += io_test_support_srcs + io_test_support_hdrs
    public_deps += [ ":io_tool_support" ]
  }
}

# A standalone gtest binary that runs all of the QUICHE unit tests, in the
# same spirit as Chromium's net_unittests target.
executable("quiche_unittests") {
  testonly = true

  configs += [ ":quiche_internal_config" ]
  public_configs = [ ":quiche_config" ]

  deps = [
    ":quiche_tests",
    "//third_party/googletest:gtest_main",
  ]
}

source_set("blind_sign_auth") {
  # Use the autogenerated source lists so this stays in sync with upstream.
  # (blind_sign_auth_srcs includes blind_sign_auth_test_data.cc, which the
  # hand-maintained list used to omit, breaking BlindSignAuthTestData::Create.)
  sources = blind_sign_auth_srcs + blind_sign_auth_hdrs

  configs += [ ":quiche_internal_config" ]
  public_configs = [ ":quiche_config" ]

  deps = [
    ":quiche",
    "//third_party/abseil-cpp:absl",
    "//third_party/anonymous_tokens:rsa_bssa_public_metadata_client",
    "//third_party/boringssl",
  ]

  public_deps = [
    ":blind_sign_auth_proto",
    "//third_party/anonymous_tokens:anonymous_tokens_rsa_bssa_client",
    "//third_party/anonymous_tokens:crypto_utils",
    "//third_party/anonymous_tokens:proto_utils",
    "//third_party/anonymous_tokens:tokens_encodings",
  ]

  defines = [ "IS_QUICHE_IMPL" ]
}

# Do not depend on this target from outside the component. Depend on
# :blind_sign_auth instead.
proto_library("blind_sign_auth_proto") {
  visibility = [
    ":blind_sign_auth",
    ":blind_sign_auth_test_support",
    ":quiche",
    ":quiche_tests",
  ]

  sources = protobuf_blind_sign_auth
  cc_generator_options = "lite=true,dllexport_decl=COMPONENT_EXPORT(QUICHE):"

  # These protos import the well-known google.protobuf.Any / Timestamp, which
  # require the full protobuf runtime (any.pb.cc / timestamp.pb.cc), so link
  # protobuf_full instead of the default protobuf_lite.
  use_protobuf_full = true

  cc_include = "third_party/googleurl/src/polyfills/base/component_export.h"
  component_build_force_source_set = true

  proto_in_dir = "src"

  link_public_deps = [ "//third_party/googleurl:url" ]

  deps = [ "//third_party/anonymous_tokens:anonymous_tokens_cc_proto" ]

  import_dirs = [ "//third_party/anonymous_tokens/src/" ]

  defines = [ "IS_QUICHE_IMPL" ]
}

source_set("blind_sign_auth_test_support") {
  visibility = [ ":quiche_tests" ]
  testonly = true
  sources = [
    "src/quiche/blind_sign_auth/test_tools/mock_blind_sign_auth_interface.h",
    "src/quiche/blind_sign_auth/test_tools/mock_blind_sign_message_interface.h",
  ]
  configs += [ ":quiche_internal_config" ]
  public_configs = [ ":quiche_config" ]

  deps = [
    ":blind_sign_auth",
    ":quiche",
    ":quiche_test_support",
    ":quiche_tool_support",
  ]

  public_deps =
      [ "//third_party/anonymous_tokens:anonymous_tokens_test_support" ]
}

if (is_android) {
  import("//build/config/android/rules.gni")

  proto_java_library("blind_sign_auth_proto_java") {
    visibility = [
      "//components/ip_protection/*",
      "//net/third_party/quiche/*",
    ]

    proto_path = "src/"

    sources = [
      "src/quiche/blind_sign_auth/proto/any.proto",
      "src/quiche/blind_sign_auth/proto/attestation.proto",
      "src/quiche/blind_sign_auth/proto/auth_and_sign.proto",
      "src/quiche/blind_sign_auth/proto/get_initial_data.proto",
      "src/quiche/blind_sign_auth/proto/key_services.proto",
      "src/quiche/blind_sign_auth/proto/proxy_layer.proto",
      "src/quiche/blind_sign_auth/proto/public_metadata.proto",
    ]

    deps = [ "//third_party/anonymous_tokens:anonymous_tokens_java_proto" ]

    import_dirs = [ "//third_party/anonymous_tokens/src/" ]
  }
}

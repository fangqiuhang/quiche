      if (!build_win_over_msvc) {
        cflags = [ "-Wno-deprecated-declarations" ]
      }
      sources = [ "src/quiche/quic/masque/masque_client_bin.cc" ]

      configs += [ ":quiche_internal_config" ]
      public_configs = [ ":quiche_config" ]

      deps = [
        ":io_tool_support",
        ":masque_support",
        ":quiche",
        ":quiche_tool_support",
        "//third_party/boringssl",
        "//third_party/protobuf:protobuf_lite",
      ]
    }
  }

  if (!is_win) {
    executable("masque_server") {
      testonly = true
      sources = [ "src/quiche/quic/masque/masque_server_bin.cc" ]

      configs += [ ":quiche_internal_config" ]
      public_configs = [ ":quiche_config" ]

      deps = [
        ":io_tool_support",
        ":masque_support",
        ":quiche",
        ":quiche_tool_support",
        "//third_party/abseil-cpp:absl",
        "//third_party/boringssl",
        "//third_party/protobuf:protobuf_lite",
      ]
    }
  }

  if (!is_win) {
    executable("masque_tcp_server") {
      testonly = true
      sources = [ "src/quiche/quic/masque/masque_tcp_server_bin.cc" ]

      configs += [ ":quiche_internal_config" ]
      public_configs = [ ":quiche_config" ]

      deps = [
        ":io_tool_support",
        ":masque_support",
        ":quiche",
        ":quiche_tool_support",
        "//third_party/boringssl",
      ]
    }
  }

  if (!is_win) {
    executable("masque_tcp_client") {
      testonly = true
      sources = [ "src/quiche/quic/masque/masque_tcp_client_bin.cc" ]

      configs += [ ":quiche_internal_config" ]
      public_configs = [ ":quiche_config" ]

      deps = [
        ":io_tool_support",
        ":masque_support",
        ":quiche",
        ":quiche_tool_support",
        "//third_party/boringssl",
      ]
    }
  }

  static_library("masque_private_tokens") {
    testonly = true
    sources = masque_private_tokens_srcs + masque_private_tokens_hdrs

    configs += [ ":quiche_internal_config" ]
    public_configs = [ ":quiche_config" ]

    public_deps = []

    deps = [
      "//third_party/abseil-cpp:absl",
      "//third_party/anonymous_tokens:crypto_utils",
      "//third_party/anonymous_tokens:rsa_blinder",
      "//third_party/anonymous_tokens:rsa_bssa_client",
      "//third_party/anonymous_tokens:tokens_encodings",
      "//third_party/boringssl",
    ]
  }

  if (!is_win) {
    executable("masque_ohttp_client") {
      testonly = true
      sources = [ "src/quiche/quic/masque/masque_ohttp_client_bin.cc" ]

      configs += [ ":quiche_internal_config" ]
      public_configs = [ ":quiche_config" ]

      deps = [
        ":io_tool_support",
        ":masque_private_tokens",
        ":masque_support",
        ":quiche",

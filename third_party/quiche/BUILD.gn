}

static_library("quiche_test_support") {
  testonly = true

  # TODO(crbug.com/325102878): Remove once usage of the deprecated version of
  # absl::HexStringToBytes have been removed.
  if (!build_win_over_msvc) {
    cflags = [ "-Wno-deprecated-declarations" ]
  }

  # Autogenerated lists (bazel: quiche_test_support_srcs/hdrs +
  # default_platform_impl_test_support_srcs/hdrs).
  sources = quiche_test_support_srcs + quiche_test_support_hdrs +
            default_platform_impl_test_support_srcs +
            default_platform_impl_test_support_hdrs

  configs += [ ":quiche_internal_config" ]
  public_configs = [ ":quiche_config" ]

  deps = [
    ":net_quic_test_tools_proto",
    ":quiche",
    ":quiche_tool_support",
    "//third_party/boringssl",
    "//third_party/googletest:gmock",
    "//third_party/protobuf:protobuf_lite",
  ]
}

static_library("quiche_tool_support") {

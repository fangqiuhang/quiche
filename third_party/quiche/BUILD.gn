      ":quic_server_core",
      ":quic_server_factory",
      ":quiche",
      ":quiche_tool_support",
      "//third_party/abseil-cpp:absl",
      "//third_party/boringssl",
    ]
  }

  executable("web_transport_test_server") {
    testonly = true
    sources = [ "src/quiche/quic/tools/web_transport_test_server.cc" ]

    configs += [ ":quiche_internal_config" ]
    public_configs = [ ":quiche_config" ]

    deps = [
      ":io_tool_support",
      ":quiche",
      ":quiche_tool_support",
      "//third_party/abseil-cpp:absl",
      "//third_party/boringssl",
    ]
  }

  if (!is_win) {
    executable("masque_client") {
      testonly = true

      # TODO(crbug.com/325102878): Remove once usage of the deprecated version of

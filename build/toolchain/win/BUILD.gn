# MSVC toolchain instantiation for Windows builds.

import("//build/toolchain/win/msvc_toolchain.gni")
import("//build/win/visual_studio_version.gni")

assert(is_win, "Should only be running on Windows")

# Instantiate the MSVC toolchain for the target architecture.
msvc_toolchain("msvc") {
  toolchain_args = {
    current_cpu = target_cpu
    current_os = "win"
    is_clang = false
  }
}

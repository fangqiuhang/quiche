import("//build/features.gni")
import("//build/toolchain/gcc_toolchain.gni")
import("//build/toolchain/toolchain.gni")

# Local path to the shared Windows tool wrapper (used by the archive tool).
if (host_os == "win" && is_win) {
  _tool_wrapper_path =
      rebase_path("//build/toolchain/win/tool_wrapper.py", root_build_dir)
}

# Resolve gcc/g++ to absolute paths at `gn gen` time, so ninja does not depend
# on the compiler being on PATH in whatever shell runs the build (e.g. building
# from PowerShell/cmd with a MinGW that only lives in the MSYS PATH).
if (host_os == "win" && is_win) {
  _gcc_path = exec_script("//build/win/find_tool.py",
                          [
                            "gcc",
                            "clang",
                          ],
                          "trim string")
  _gxx_path = exec_script("//build/win/find_tool.py",
                          [
                            "g++",
                            "clang++",
                          ],
                          "trim string")
  _ar_path = exec_script("//build/win/find_tool.py",
                         [
                           "ar",
                           "llvm-ar",
                         ],
                         "trim string")
} else {
  _gcc_path = "gcc"
  _gxx_path = "g++"
}

clang_toolchain("clang") {
  toolchain_args = {
    current_cpu = current_cpu
    current_os = current_os
  }
}

toolchain("gcc") {
  tool("cc") {
    depfile = "{{output}}.d"
    command = "\"$_gcc_path\" -MMD -MF $depfile {{defines}} {{include_dirs}} {{cflags}} {{cflags_c}} -c {{source}} -o {{output}}"
    depsformat = "gcc"
    description = "CC {{output}}"
    outputs =
        [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.o" ]
  }

  tool("cxx") {
    depfile = "{{output}}.d"
    command = "\"$_gxx_path\" -MMD -MF $depfile {{defines}} {{include_dirs}} {{cflags}} {{cflags_cc}} -c {{source}} -o {{output}}"
    depsformat = "gcc"
    description = "CXX {{output}}"
    outputs =
        [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.o" ]
  }

  tool("alink") {
    rspfile = "{{output}}.rsp"
    if (is_win) {
      # Build a fresh archive via the Python wrapper: cmd's del/move cannot
      # handle the forward-slash paths ninja passes, so a bare
      # `del /f ... & ar rcs ...` keeps stale members of an existing archive
      # (e.g. objects from sources that were removed). The wrapper always
      # produces a clean archive.
      command = "\"$python_path\" $_tool_wrapper_path create-archive --ar=\"$_ar_path\" {{output}} $rspfile"
    } else {
      command = "rm -f \"{{output}}\" && ar rcs {{output}} @$rspfile"
    }
    description = "AR {{target_output_name}}{{output_extension}}"
    rspfile_content = "{{inputs}}"

    outputs =
        [ "{{target_out_dir}}/{{target_output_name}}{{output_extension}}" ]
    default_output_extension = ".a"
    output_prefix = "lib"
  }

  tool("asm") {
    # For GCC we can just use the C compiler to compile assembly.
    depfile = "{{output}}.d"
    command = "\"$_gcc_path\" -MMD -MF $depfile {{defines}} {{include_dirs}} {{asmflags}} -c {{source}} -o {{output}}"
    depsformat = "gcc"
    description = "ASM {{output}}"
    outputs =
        [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.o" ]
  }

  tool("solink") {
    soname = "{{target_output_name}}{{output_extension}}"  # e.g. "libfoo.so".
    sofile = "{{output_dir}}/$soname"
    rspfile = soname + ".rsp"
    if (is_mac) {
      os_specific_option = "-install_name @executable_path/$sofile"
      rspfile_content = "{{inputs}} {{solibs}} {{libs}}"
    } else {
      os_specific_option = "-Wl,-soname=$soname"
      rspfile_content = "-Wl,--whole-archive {{inputs}} {{solibs}} -Wl,--no-whole-archive {{libs}}"
    }

    command = "\"$_gxx_path\" -shared {{ldflags}} -o $sofile $os_specific_option @$rspfile"

    description = "SOLINK $soname"

    # Use this for {{output_extension}} expansions unless a target manually
    # overrides it (in which case {{output_extension}} will be what the target
    # specifies).
    default_output_extension = ".so"

    # Use this for {{output_dir}} expansions unless a target manually overrides
    # it (in which case {{output_dir}} will be what the target specifies).
    default_output_dir = "{{root_out_dir}}"

    outputs = [ sofile ]
    link_output = sofile
    depend_output = sofile
    output_prefix = "lib"
  }

  tool("link") {
    outfile = "{{target_output_name}}{{output_extension}}"
    rspfile = "$outfile.rsp"
    if (is_mac) {
      command =
          "\"$_gxx_path\" {{ldflags}} -o $outfile @$rspfile {{solibs}} {{libs}}"
    } else if (is_win) {
      # -static bakes libstdc++/libgcc/libwinpthread into the binary so the
      # produced executables (protoc, test binaries, ...) run without the
      # MinGW runtime DLLs being on PATH.
      command = "\"$_gxx_path\" -static {{ldflags}} -o $outfile -Wl,--start-group @$rspfile {{solibs}} -Wl,--end-group {{libs}} -lws2_32"
    } else {
      command = "\"$_gxx_path\" {{ldflags}} -o $outfile -Wl,--start-group @$rspfile {{solibs}} -Wl,--end-group {{libs}}"
    }
    description = "LINK $outfile"
    default_output_dir = "{{root_out_dir}}"
    if (is_win) {
      default_output_extension = ".exe"
    }
    rspfile_content = "{{inputs}}"
    outputs = [ outfile ]
  }

  # Use the standard copy/stamp commands from toolchain.gni (same as the MSVC
  # toolchain): the copy wrapper creates missing destination directories,
  # unlike a bare `cmd /c copy /y` which fails on a clean build when the
  # target directory does not exist yet (e.g. anonymous_tokens test_data).
  tool("stamp") {
    command = stamp_command
    description = stamp_description
  }

  tool("copy") {
    command = copy_command
    description = copy_description
  }
}
